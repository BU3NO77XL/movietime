{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd apps/movietime_web && corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "cd apps/movietime_web && pnpm build",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/animated-backdrops/:path*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/mp4"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    }
  ]
}
